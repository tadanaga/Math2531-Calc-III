\newcommand{\class}{Math 2531}
\newcommand{\term}{Fall 2026}
\newcommand{\instructor}{T. Takahashi}
\newcommand{\lessonid}{}
\newcommand{\lessontitle}{}
\newboolean{showanswer}
\setboolean{showanswer}{true}
% Use \setboolean{showanswer}{false} for a student copy.
