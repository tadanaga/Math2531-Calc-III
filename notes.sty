}
\pagestyle{pages}

% \lesson[short subtitle]{number}{title} also sets running headers.
\NewDocumentCommand{\lesson}{O{} m m}{%
  \renewcommand{\lessonid}{#2}\renewcommand{\lessontitle}{#3}%
  \hypersetup{pdftitle={\class: #2 #3}}%
  {\small\sffamily\bfseries\color{notesteal}\MakeUppercase{\class\enspace /\enspace Lecture Notes}\par}
  \vspace{3pt}
  {\fontsize{25}{30}\selectfont\bfseries\color{notesink}#2\enspace #3\par}
  \IfBlankF{#1}{{\small\color{notesmuted}#1\par}}
  \vspace{5pt}{\color{notesteal}\hrule height 1.2pt}\vspace{8pt}
}

% Shared box settings: labels remain readable when printed in grayscale.
\tcbset{notesbox/.style={enhanced,breakable,sharp corners,boxrule=0pt,
  frame hidden,borderline west={2pt}{0pt}{notesblue},colback=notesblue!4,
  coltitle=notesblue,fonttitle=\small\sffamily\bfseries,
  attach title to upper={\par\smallskip},left=10pt,right=10pt,top=6pt,bottom=6pt,
  before skip=6pt,after skip=6pt}}
\newtcolorbox{learninggoals}{notesbox,colback=notesteal!4,
  borderline west={2pt}{0pt}{notesteal},coltitle=notesteal,title=Learning goals}
\newtcolorbox{definition}[1][]{notesbox,
  title={Definition\IfBlankF{#1}{\enspace /\enspace #1}}}
\newtcolorbox{keyidea}[1][]{notesbox,colback=notesteal!5,
  borderline west={2pt}{0pt}{notesteal},coltitle=notesteal,
  title={Key idea\IfBlankF{#1}{\enspace /\enspace #1}}}
\newtcolorbox{commonmistake}[1][]{notesbox,colback=notesgold!6,
  borderline west={2pt}{0pt}{notesgold},coltitle=notesgold,
  title={Watch out\IfBlankF{#1}{\enspace /\enspace #1}}}
\newtcolorbox{checkpoint}[1][]{notesbox,colback=white,
  borderline west={2pt}{0pt}{notesmuted},coltitle=notesink,
  title={Quick check\IfBlankF{#1}{\enspace /\enspace #1}}}
\newtcolorbox{takeaway}{notesbox,colback=notesteal!4,
  borderline west={2pt}{0pt}{notesteal},coltitle=notesteal,title=Takeaway}

% Preserve the original syntax: \begin{example}[label]{problem} solution \end{example}.
% An omitted label uses automatic numbering. Solutions can be hidden globally.
\newcounter{example}
\NewDocumentEnvironment{example}{O{} +m +b}{%
  \refstepcounter{example}%
  \begin{tcolorbox}[notesbox,colback=white,boxrule=0.5pt,frame hidden=false,
    colframe=notesrule,borderline west={2pt}{0pt}{exampleaccent},
    title={Example\enspace\IfBlankTF{#1}{\theexample}{#1}},
    segmentation style={solid,notesrule}]
    #2
    \tcblower
    \ifthenelse{\boolean{showanswer}}{%
      \textcolor{notesteal}{\textbf{Solution.}} #3
    }{\textcolor{notesmuted}{\small Work space}\par\vspace{\solutionheight}}
  \end{tcolorbox}
}{}
% Inline answers disappear in a student copy; the question remains visible.
\NewDocumentCommand{\answer}{+m}{%
  \ifthenelse{\boolean{showanswer}}{\par\smallskip\textcolor{notesteal}{\textbf{Answer.}} #1}{}%
}
\NewDocumentCommand{\workingspace}{O{18mm}}{\par\vspace{#1}}
\newtheorem{theorem}{Theorem}

% Existing conveniences retained for future lessons.
\newenvironment{ans}{\begin{itemize}\color{notesblue}}{\end{itemize}}
\newenvironment{note}{\begin{itemize}\color{notesgold}}{\end{itemize}}
